      "hits": 1
    },
    {
      "id": "demo-lt-002",
      "text": "主人在做一份要长时间盯屏幕的工作，晚上常常十一点后才闲下来。",
      "topic": "profile",
      "kind": "fact",
      "confirmed": true,
