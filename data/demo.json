      "hits": 4
    },
    {
      "id": "demo-lt-005",
      "text": "周三是主人最忙的一天，通常没空聊天。",
      "topic": "schedule",
      "kind": "fact",
      "confirmed": true,
      "createdAt": 1787457600000,
      "lastMentionAt": 1792555200000,
      "hits": 1
    },
    {
      "id": "demo-lt-006",
      "text": "主人在养一只叫「年糕」的橘猫，掉毛很厉害。",
      "topic": "pet",
      "kind": "fact",
      "confirmed": true,
